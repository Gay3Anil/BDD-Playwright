{
  "name": "playwright-bdd-framework",
  "version": "1.0.0",
  "private": true,
  "description": "BDD browser automation using Cucumber, TypeScript, and Playwright.",
  "scripts": {
    "test:bdd": "tsx test-runner/runner.ts",
    "test:bdd:html": "tsx test-runner/runner.ts",
    "test:bdd:headed": "cross-env HEADLESS=false tsx test-runner/runner.ts",
    "test:bdd:smoke": "tsx test-runner/runner.ts --tags @smoke"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.2.0",
    "@types/node": "^24.0.0",
    "cross-env": "^10.0.0",
    "dotenv": "^16.4.7",
    "playwright": "^1.55.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}